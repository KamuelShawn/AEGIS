# =========================================================
# SUSTAINA — environment configuration
# Copy to backend/.env and fill in what you have. Missing keys do NOT
# block the app: providers fall back to CACHED, then DEMO data,
# and the UI labels the data source honestly.
# =========================================================

# ---------------------------------------------------------
# MAP (mandatory for a polished map; app runs on MapLibre demo
# tiles without it, but Mapbox styles/geocoding need this)
# ---------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------------------------------------------------------
# SATELLITE — Copernicus Data Space Ecosystem
# Sign up: https://dataspace.copernicus.eu/
# STAC endpoint used: https://stac.dataspace.copernicus.eu/v1/
# ---------------------------------------------------------
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ---------------------------------------------------------
# INDIAN GOVERNMENT OPEN DATA
# Sign up: https://data.gov.in/
# ---------------------------------------------------------
DATA_GOV_API_KEY=

# ---------------------------------------------------------
# TERRAIN / ELEVATION — OpenTopography (optional)
# Sign up: https://opentopography.org/
# ---------------------------------------------------------
OPENTOPOGRAPHY_API_KEY=

# ---------------------------------------------------------
# GOOGLE MAPS PLATFORM (optional — supplemental only)
# ---------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------
# LLM — explanation layer ONLY, never a source of quantitative
# truth (see docs/ARCHITECTURE.md). Optional.
# ---------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
DATABASE_URL=postgresql://sustaina:sustaina@localhost:5432/sustaina

# ---------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_ENV=development
# Force all providers into demo mode regardless of keys present
FORCE_DEMO_MODE=false
